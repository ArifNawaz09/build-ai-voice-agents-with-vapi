# Copy this file to .env and fill in real values.
# Never commit .env to git.

# Vapi PRIVATE API key (Dashboard > API Keys > Private API Keys).
# Server-side only. Never ship it to a browser or mobile app.
VAPI_API_KEY=

# Shared secret Vapi sends with every webhook. Put the same value
# in a Bearer Token custom credential in the Vapi dashboard.
VAPI_WEBHOOK_SECRET=

# ID of that custom credential (Integrations > Server Configuration).
# Scripts put it in assistant.server.credentialId.
VAPI_CREDENTIAL_ID=

# Public HTTPS base URL of this server, with no trailing slash.
# In development: your ngrok or Cloudflare Tunnel URL.
PUBLIC_BASE_URL=

# Local port for Express.
PORT=3000

# ID (not the digits) of the Vapi phone number used for outbound
# calls. Must be an imported number (Twilio, Telnyx, Vonage, SIP).
VAPI_PHONE_NUMBER_ID=

# E.164 number of the human who takes transferred calls.
AGENT_TRANSFER_NUMBER=

# IANA time zone of the business, used for hours and bookings.
BUSINESS_TZ=America/New_York

# Optional: saved assistant for inbound calls (assistant-request fallback)
INBOUND_ASSISTANT_ID=

# --- Chapter 7: lead qualifier ---
LEAD_ASSISTANT_ID=
LEAD_OUTPUT_ID=
COMPANY_NAME=Brightway Realty
# Spoken callback number for voicemail and opt-out
CALLBACK_NUMBER_SPOKEN=five five five, five five five, zero one zero zero
# Calling window in the LEAD's timezone (24h clock)
CALL_WINDOW_START=9
CALL_WINDOW_END=20
CALL_WINDOW_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
# When live transfers are offered (BUSINESS_TZ)
AGENT_HOURS_START=9
AGENT_HOURS_END=19
AGENT_HOURS_DAYS=Mon,Tue,Wed,Thu,Fri,Sat
# Optional: Slack/Zapier/n8n/CRM webhook for alerts
NOTIFY_WEBHOOK_URL=

# --- Chapter 8: booking ---
BOOKING_ASSISTANT_ID=
BOOKING_OUTPUT_ID=
OPEN_HOURS_START=9
OPEN_HOURS_END=17
OPEN_HOURS_DAYS=Mon,Tue,Wed,Thu,Fri
SLOT_MINUTES=30
MIN_NOTICE_MINUTES=120
BOOKING_HORIZON_DAYS=14

# --- Chapter 9: insurance screening ---
INSURANCE_ASSISTANT_ID=
INSURANCE_OUTPUT_ID=
LICENSED_STATES=TX,FL,GA,NC,AZ
TRANSFER_HOURS_START=9
TRANSFER_HOURS_END=18
TRANSFER_HOURS_DAYS=Mon,Tue,Wed,Thu,Fri
# Optional override, e.g. blind-transfer-add-summary-to-sip-header
TRANSFER_MODE=
# Exact wording from your compliance team
MEDICARE_DISCLAIMER=

# --- Chapters 11-12 (optional) ---
TEST_TARGET_NUMBER=
ALERT_WEBHOOK_URL=
STAGE=staging
